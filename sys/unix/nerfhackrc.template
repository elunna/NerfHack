# -----------------------------------------------------------------------------
# E) Keybindings
# BIND=key:command rebinds a single key to a named command (the same names
# used by the #name-less form of extended commands). Useful for commands you
# use often enough that typing '#command<enter>' every time is annoying.

# Instead of typing out #untrap, use 'v'.
BIND=v:untrap
# Instead of #rub, use '~'.
#BIND=~:rub
# Instead of #dip, use '!'.
#BIND=!:dip

# -----------------------------------------------------------------------------
# F) Interface Settings

# Inventory pack order: the order object classes are listed in when NetHack
# groups your inventory by type (e.g. in the drop menu). This is the
# standard/default order, spelled out explicitly here as a base to edit.
OPTIONS=packorder:$")[%?+!=/(*`0_

# Alternative: puts worn-item classes (armor, rings) earlier, making them
# easier to find at a glance if you frequently check what's equipped.
#OPTIONS=packorder:")[=%?+!/(*`0_$

# Display yourself as the glyph for your race (e.g. 'h' for a dwarf) rather
# than the generic '@' role glyph. Purely cosmetic -- doesn't change how the
# game treats you -- but can be a handy reminder when deciding what to
# genocide/exile.
OPTIONS=showrace

# Highlight pets with inverse color, so they stand out from hostile
# monsters of the same glyph at a glance.
OPTIONS=hilite_pet

# Highlight piles of items on the floor with inverse color.
OPTIONS=hilite_pile

# While far-looking (';') or examining the map, show a description of
# what's under the cursor as you move it, instead of needing to press a key
# to ask each time.
OPTIONS=autodescribe

# Randomly-triggered clairvoyance normally pauses so you can browse the
# revealed map ("you sense your surroundings..."). This skips that pause.
# Doesn't affect the deliberate clairvoyance spell, and is ignored while
# underwater or engulfed.
OPTIONS=quick_farsight

# "Sparkle" is a brief flashing animation on some magical effects; many
# players find it more distracting than informative.
OPTIONS=!sparkle

# Skip the "NetHack, Copyright..." splash/intro message. Handy for
# speedrunning or just getting into the game faster.
OPTIONS=legacy

# When on, a known uncursed item is displayed without the word "uncursed"
# (since unmarked is the common case and "blessed"/"cursed" already stand
# out). This file disables that shorthand -- explicit is better than
# implicit, so uncursed status is always spelled out.
OPTIONS=!implicit_uncursed

# Only show the parts of a lit room currently in your line of sight, hiding
# the rest of the room even though you remember it's lit. Off by default in
# vanilla; this file turns it on for a more fog-of-war-like feel.
OPTIONS=dark_room

# NetHack normally offers extra guidance when it detects some likely
# mistakes (e.g. suggesting the right command after a typo). Disabled here
# for a less hand-held experience once you know the game.
OPTIONS=!cmdassist

## Message history
# How much of your recent message history is kept, and in what order.
# msg_window:reversed shows the fullscreen history (^P repeatedly, or the
# equivalent menu) most-recent-message-first.
OPTIONS=msg_window:reversed
# Number of lines of history retained for scrolling back through with ^P.
# The tty/X11/Gem ports accept 20-60; this sets it to the maximum.
OPTIONS=msghistory:60

# -----------------------------------------------------------------------------
# G) Status Bar Settings

# Show accumulated experience points on the status line. Disabling frees up
# a little status bar space if you don't reference it often.
OPTIONS=showexp

# Show the game version on the status line (see versinfo below for what
# exactly gets shown), and helpful contextual tips.
OPTIONS=showvers
# versinfo is a bitmask controlling what showvers displays: 1 = version
# number (x.y.z), 2 = program name, 4 = git branch (if the build knows one;
# falls back to showing the version number if no branch info is available).
# 7 = all three combined.
OPTIONS=versinfo=7

# Periodic gameplay tips
OPTIONS=!tips

# Show elapsed turn count on the status bar.
OPTIONS=time

# Render current/max HP and Pw as a graphical bar rather than plain numbers.
OPTIONS=hitpointbar

# Score estimate on the status bar. Commented out here since it just adds
# clutter for most players; uncomment if you like tracking it live.
#OPTIONS=showscore

## Status highlighting
