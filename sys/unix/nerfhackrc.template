AUTOPICKUP_EXCEPTION="<.*winged boots"
AUTOPICKUP_EXCEPTION="<.*jungle boots"
AUTOPICKUP_EXCEPTION="<.*hiking boots"
AUTOPICKUP_EXCEPTION="<.*steel-toed boots"
