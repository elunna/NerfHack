# -----------------------------------------------------------------------------
# I) MSGTYPE Settings
# MSGTYPE=verb "PATTERN" changes how a matching game message is displayed.
# PATTERN is a regular expression matched against the message text. Verbs:
#   show   - display normally (the default; rarely needed explicitly)
#   hide (alias noshow) - suppress the message entirely
#   norep  - display, but don't count as a "new" message if it repeats
#            immediately (keeps spammy-but-sometimes-useful messages like
#            "you see here a ..." from flooding the message history)
#   stop (alias more) - force a --More-- prompt after this message
#   alert  - force acknowledgement with <TAB> -- stronger than stop, for
#            messages you must not accidentally skim past
# Rules are evaluated in order; put more specific patterns first.

## Mundane messages / spam
# These are self-evident enough not to need a message each time.
MSGTYPE=hide "(Aloha|Salutations|Konnichi wa|Velkommen|Hallo) .*"
#MSGTYPE=hide "welcome to NetHack!"
MSGTYPE=hide "Restoring save file..." # first-time players don't need to see this
MSGTYPE=norep "You see here a .*"
MSGTYPE=norep "You see here an .*"
#MSGTYPE=hide "You drop .*"
MSGTYPE=hide "You swap places with .*"
MSGTYPE=hide "You descend .*"
MSGTYPE=hide "You (climb|fly) (up|down) .*"
